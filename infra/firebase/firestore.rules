rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Conversation logs are server-admin only (see SDD §3.6).
    match /conversations/{doc=**} { allow read, write: if false; }
    match /messages/{doc=**}      { allow read, write: if false; }
    match /usage_daily/{doc=**}   { allow read, write: if false; }

    // Users may read their own profile document; writes stay server-side.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
