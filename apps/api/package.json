{
  "name": "@pr-training/api",
  "version": "2.0.0-0",
  "private": true,
  "type": "module",
  "description": "Secure API proxy for the PR Training App — validates Firebase JWTs, enforces quotas, forwards to Azure OpenAI and ElevenLabs.",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file=../../.env.local src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "^12.1.0",
    "jose": "^5.2.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^1.5.0"
  }
}
