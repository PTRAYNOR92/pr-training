# Union of env vars used across the monorepo.
# Copy the relevant subset into apps/web/.env.local and apps/api/.env.local.
# NEVER commit real values.

# --- apps/web (Vite — only VITE_ prefixed vars are exposed to the browser) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=http://localhost:3000

# --- apps/api ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Firebase (admin) — used for JWT verification + Firestore writes
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.json

# AI provider (abstraction — choose one)
AI_PROVIDER=azure-openai                    # azure-openai | openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
OPENAI_API_KEY=

# Voice
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# Quotas / rate limits
DAILY_TOKEN_LIMIT_PER_USER=10000
IP_RATE_LIMIT_PER_MINUTE=100

# CORS — comma-separated allowlist
CORS_ALLOWED_ORIGINS=http://localhost:5173
